TEMPMAIL_PORT=5001
TEMPMAIL_SMTP_PORT=2525
TEMPMAIL_POSTGRES_URL=postgres://postgres:postgres@localhost:5432/tempmail?sslmode=disable
# Redis/Valkey: satu URL (user:sandi@ip:port/db) — username/password/db index
# ikut di dalam URL; tidak perlu key password terpisah. Default:
# redis://localhost:6379/0.
TEMPMAIL_REDIS_URL=redis://localhost:6379/0
TEMPMAIL_REDIS_PREFIX=tempmail-xgmail:
TEMPMAIL_APP_ENV=development
TEMPMAIL_PUBLIC_API_KEY=public-dev-key
TEMPMAIL_DEFAULT_DOMAIN=mail.tempmail.dev
TEMPMAIL_MX_TARGET=email.xgmail.bond
TEMPMAIL_MAX_INBOX_EXPIRATION=24h
TEMPMAIL_SMTP_GREETING=mail.xgmail.bond
TEMPMAIL_FRONTEND_URL=http://localhost:5173
TEMPMAIL_DNS_RESOLVERS=1.1.1.1:53,8.8.8.8:53,9.9.9.9:53
TEMPMAIL_RATE_LIMIT_API_MAX=300
TEMPMAIL_RATE_LIMIT_API_WINDOW_MINUTES=15
TEMPMAIL_RATE_LIMIT_STRICT_MAX=20
TEMPMAIL_RATE_LIMIT_STRICT_WINDOW_MINUTES=1

# ── domain MX lifecycle & DNS resolver ──
# Grace sebelum domain non-default yang MX-nya invalid dihapus otomatis.
TEMPMAIL_DOMAIN_MX_GRACE=10m
# Interval sweep domain pending (mxVerified=false) dan re-verify domain aktif.
TEMPMAIL_MX_SWEEP_INTERVAL=1m
TEMPMAIL_MX_REFRESH_INTERVAL=30m
# Per-attempt timeout dan jumlah putaran retry lintas TEMPMAIL_DNS_RESOLVERS.
TEMPMAIL_DNS_LOOKUP_TIMEOUT=3s
TEMPMAIL_DNS_LOOKUP_ROUNDS=2
# Pool resolver dinamis: di-fetch dari URL ini dan di-refresh berkala untuk
# round-robin + fallback. Kosongkan URL untuk pakai TEMPMAIL_DNS_RESOLVERS statis saja.
TEMPMAIL_DNS_RESOLVERS_URL=https://raw.githubusercontent.com/proabiral/Fresh-Resolvers/refs/heads/master/resolvers.txt
TEMPMAIL_DNS_RESOLVERS_REFRESH=24h
# Interval pengecekan registry (RDAP) untuk status + expire date domain
# non-default, dan TTL cache Valkey hasilnya. Domain expired dihapus otomatis.
TEMPMAIL_RDAP_REFRESH_INTERVAL=24h
TEMPMAIL_RDAP_CACHE_TTL=24h

# ── sender-domain icon (BIMI) fetch ──
# Timeout download logo BIMI per domain dan batas ukuran bytes logo.
TEMPMAIL_DOMAIN_ICON_TIMEOUT=5s
TEMPMAIL_DOMAIN_ICON_MAX_BYTES=131072

# Maksimal resolver yang dicoba per lookup saat pool dinamis besar.
TEMPMAIL_DNS_LOOKUP_SAMPLE=8
